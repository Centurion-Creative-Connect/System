      Data: 34|UnityEngine.TooltipAttribute, UnityEngine.CoreModule
    - Name: tooltip
      Entry: 1
      Data: 'Additional dot-product margin required to enter walking state from running
        state.

        Once walking, player stays walking until gun direction falls
        below the threshold itself.

        Prevents sudden speed reductions when
        gun direction hovers around the threshold.'
